# ═══════════════════════════════════════════════════════════════
# KalzTunz — Environment Variables Reference
# Copy to .env and fill in. Grouped by how critical each var is.
# ═══════════════════════════════════════════════════════════════


# ───────────────── 🔴 CRITICAL — app is broken or insecure without these ─────────────────

# JWT signing key for all auth tokens. If unset, auth.py falls back to a
# hardcoded dev string ("dev-insecure-key-change-in-production") and just
# logs a warning — it will NOT stop the app from starting, which means it's
# very easy to accidentally run production on an insecure default key.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Postgres connection string. database.py falls back to a localhost dev
# default that will fail to connect anywhere except a local Postgres.
DATABASE_URL=postgresql://kalztunz_user:secure_password@localhost:5432/kalztunz

# Controls: HTTPS redirect middleware, whether /docs /redoc /openapi.json
# are exposed (hidden in production), and reload mode.
# Values: development | production
ENVIRONMENT=development

# Comma-separated list of hosts Starlette's TrustedHostMiddleware will
# accept. Requests with a Host header not in this list get a 400 — this
# is a common cause of "works locally, 400s in production."
# Must include your actual deployed domain.
ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com

# Comma-separated allowed CORS origins. Only matters if the frontend is
# served from a different origin than the API (e.g. separate static host,
# or local dev on :5173 talking directly to :8000 without the Vite proxy).
# For the unified single-service deployment (FastAPI serving the built
# React app from the same origin) this is mostly a no-op but should still
# match your real frontend URL.
CORS_ORIGINS=http://localhost:8000


# ───────────────── 🟡 IMPORTANT — background job processing ─────────────────

# Without Redis, the app still works: /api/generate and /api/extract-chords
# both fall back to a *synchronous* code path (see app.py — `require_queue()`
# returns None, the endpoint runs tasks.py directly and returns the full
# result immediately instead of a job_id to poll). This means:
#   - Generation/extraction will block the request until done (slower,
#     and a large file extraction can time out a reverse-proxy/gunicorn
#     worker on a 30-60s timeout).
#   - The worker.py process (separate RQ worker) has nothing to consume
#     and is effectively idle.
# For anything beyond local testing, set this up properly.
REDIS_URL=redis://localhost:6379/0

# Which queue(s) the worker.py process listens on. Must match the queue
# name app.py enqueues to ("kalztunz" — see task_queue = Queue("kalztunz", ...)).
WORKER_QUEUES=kalztunz


# ───────────────── 🟢 FEATURE-SPECIFIC — app runs fine without these, that feature just degrades ─────────────────

# Music Discovery / Search page. Without these, backend/spotify.py returns
# 503 "Spotify credentials not configured" and the frontend shows a
# "Connect Spotify" banner instead of search results. Free tier at
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# "Continue with Google" login. Without these, auth.py's /api/auth/google
# returns 501 "Google OAuth not configured" — normal username/password
# signup and login are unaffected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# "Continue with GitHub" login. Same as above — 501 if unset, password
# auth still works.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Where OAuth callbacks redirect back to after Google/GitHub sign-in
# (must match the actual public URL of your frontend, not localhost, once
# deployed — auth.py builds `{FRONTEND_URL}/auth/callback?access_token=...`).
FRONTEND_URL=http://localhost:8000

# Transactional email (welcome emails, follow notifications). Without
# SENDER_PASSWORD, emailer_enhanced.py's EmailService.enabled is False and
# it just logs "Email disabled — would send to..." instead of sending —
# non-fatal, nothing in the app depends on email actually arriving.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=noreply@kalztunz.com
SENDER_PASSWORD=


# ───────────────── ⚪ COSMETIC / RARELY NEEDED ─────────────────

PORT=8000
METRICS_PORT=9091
UPLOAD_DIR=uploads
SQL_ECHO=false
LOG_LEVEL=info
